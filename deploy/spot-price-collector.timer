# Tracked copy of /etc/systemd/system/spot-price-collector.timer — edit here, then:
# sudo cp deploy/spot-price-collector.timer /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=Run spot price collector every 15 minutes

[Timer]
OnCalendar=*:0/15
Persistent=true

[Install]
WantedBy=timers.target
